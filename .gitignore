# ---- Virtual environments (DON'T COMMIT) ----
.venv/
venv/
env/
ENV/

# ---- Python cache / compiled files ----
__pycache__/
*.py[cod]
*$py.class

# ---- PyTorch / training artifacts (usually large) ----
checkpoints/
runs/
*.pt
*.pth

# ---- Datasets / downloaded data (large) ----
data/
datasets/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- IDE / editor settings ----
.idea/
.vscode/

# ---- Logs ----
*.log
